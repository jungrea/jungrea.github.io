---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import RightSidebar from '../../components/RightSidebar.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../utils/url';

const allPosts = await getCollection('blog');

// 收集筛选数据
const yearMap = new Map<string, number>();
const monthMap = new Map<string, number>();
const tagMap = new Map<string, number>();
const grouped: Record<string, typeof allPosts> = {};

allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .forEach(post => {
    const date = post.data.pubDate;
    const year = date.getFullYear().toString();
    const month = `${year}-${String(date.getMonth() + 1).padStart(2, '0')}`;

    yearMap.set(year, (yearMap.get(year) || 0) + 1);
    monthMap.set(month, (monthMap.get(month) || 0) + 1);
    for (const tag of post.data.tags || []) {
      tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
    }

    if (!grouped[year]) grouped[year] = [];
    grouped[year].push(post);
  });

const years = [...yearMap.entries()].sort((a, b) => Number(b[0]) - Number(a[0]));
const months = [...monthMap.entries()].sort((a, b) => b[0].localeCompare(a[0]));
const tags = [...tagMap.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout
  title="文章列表 — My Blog"
  description="所有文章列表"
  currentPath={withBase('/blog')}
  sidebarIndex={{ years, months, tags }}
>
  <RightSidebar slot="right-sidebar" posts={allPosts} />

  <div class="section">
    <div class="blog-header">
      <h1 class="page-title">全部文章</h1>
      <p class="page-subtitle">共 {allPosts.length} 篇</p>
    </div>

    <div class="blog-layout">
      <div class="blog-main">
        {years.map(([year]) => (
          <section class="year-section" data-year={year}>
            <h2 class="year-title">{year}</h2>
            <div class="post-list">
              {grouped[year].map((post, i) => {
                const date = post.data.pubDate;
                const month = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
                const tagStr = (post.data.tags || []).join(',');
                return (
                  <div
                    class="stagger-1"
                    style={`animation-delay: ${i * 0.05}s`}
                    data-year={year}
                    data-month={month}
                    data-tags={tagStr}
                  >
                    <PostCard post={{ ...post.data, slug: post.slug }} />
                  </div>
                );
              })}
            </div>
          </section>
        ))}
        <div class="no-results" id="noResults" style="display:none;">
          没有符合筛选条件的文章
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const chips = document.querySelectorAll<HTMLElement>('.filter-chip[data-filter]');
  const resetBtn = document.getElementById('filterReset') as HTMLButtonElement | null;
  const noResults = document.getElementById('noResults') as HTMLDivElement | null;

  const filters: Record<string, Set<string>> = {
    year: new Set(),
    month: new Set(),
    tag: new Set(),
  };
  let activeCategory: string | null = null;

  const initialParams = new URLSearchParams(window.location.search);
  (['year', 'month', 'tag'] as const).forEach(type => {
    initialParams.getAll(type).forEach(value => {
      if (value) {
        filters[type].add(value);
        activeCategory = type;
      }
    });
  });

  function syncFilterUrl() {
    const params = new URLSearchParams();
    if (activeCategory) {
      filters[activeCategory].forEach(value => params.append(activeCategory!, value));
    }
    const query = params.toString();
    history.replaceState(null, '', `${window.location.pathname}${query ? `?${query}` : ''}`);
  }

  function apply() {
    let visibleCount = 0;

    // 更新 chip 状态
    chips.forEach(chip => {
      const type = chip.dataset.filter!;
      const value = chip.dataset.value!;
      const active = filters[type].has(value);
      chip.classList.toggle('active', active);
    });

    // 显示/隐藏文章
    document.querySelectorAll<HTMLElement>('.post-list > div').forEach(card => {
      const y = card.dataset.year;
      const m = card.dataset.month;
      const t = (card.dataset.tags || '').split(',').filter(Boolean);

      const matchYear = filters.year.size === 0 || filters.year.has(y || '');
      const matchMonth = filters.month.size === 0 || filters.month.has(m || '');
      const matchTag = filters.tag.size === 0 || t.some(tag => filters.tag.has(tag));

      const show = matchYear && matchMonth && matchTag;
      card.style.display = show ? '' : 'none';
      if (show) visibleCount++;
    });

    // 显示/隐藏 year-section（如果该年下没有文章则隐藏）
    document.querySelectorAll<HTMLElement>('.year-section').forEach(section => {
      const hasVisible = section.querySelectorAll('.post-list > div[style=""], .post-list > div:not([style*="display: none"])').length > 0;
      section.style.display = hasVisible ? '' : 'none';
    });

    // 重置按钮
    const hasFilter = activeCategory !== null;
    if (resetBtn) resetBtn.style.display = hasFilter ? '' : 'none';
    if (noResults) noResults.style.display = visibleCount === 0 && hasFilter ? '' : 'none';
  }

  chips.forEach(chip => {
    chip.addEventListener('click', (event) => {
      event.preventDefault();
      const type = chip.dataset.filter!;
      const value = chip.dataset.value!;

      // 类别互斥：切换到不同类别时，清空其他类别
      if (activeCategory && activeCategory !== type) {
        filters[activeCategory].clear();
      }

      // 当前类别内 toggle
      if (filters[type].has(value)) {
        filters[type].delete(value);
        if (filters[type].size === 0) activeCategory = null;
      } else {
        filters[type].add(value);
        activeCategory = type;
      }

      syncFilterUrl();
      apply();
    });
  });

  resetBtn?.addEventListener('click', () => {
    filters.year.clear();
    filters.month.clear();
    filters.tag.clear();
    activeCategory = null;
    syncFilterUrl();
    apply();
  });

  apply();
</script>

<style>
  .section {
    width: 100%;
    max-width: var(--max-width-wide);
    padding: 0.8rem 0 2rem;
  }

  .blog-header {
    margin-bottom: 1.5rem;
  }

  .page-title {
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 0.25rem;
  }

  .page-subtitle {
    color: var(--text-tertiary);
    font-size: 0.9rem;
  }

  .blog-layout {
    display: block;
  }

  /* 文章列表 */
  .blog-main {
    flex: 1;
    min-width: 0;
  }

  .year-section { margin-bottom: 1.5rem; }

  .year-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 0.6rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--border-light);
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .no-results {
    text-align: center;
    color: var(--text-tertiary);
    padding: 3rem;
    font-size: 0.95rem;
  }

  @media (max-width: 960px) {
    .section {
      padding: 1.4rem 0 2rem;
    }
  }
</style>
