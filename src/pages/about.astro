---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/url';
---

<BaseLayout title="关于 — My Blog" description="关于我和这个博客" currentPath={withBase('/about')}>
  <div class="container section">
    <h1 class="page-title">👤 关于</h1>

    <div class="about-card">
      <h2>关于我</h2>
      <p>
        你好，我是 <strong>Jungrea</strong>，一名热爱技术的开发者，大厂程序员。
      </p>
      <p>
        这个博客记录我在编程、技术、工具等方面的学习与思考。
        我喜欢探索新技术，也乐于分享自己的实践经验。
      </p>
    </div>

    <div class="about-card">
      <h2>联系我 · 关注我</h2>
      <div class="contact-grid">
        <div class="contact-item">
          <div class="contact-icon">🐙</div>
          <div class="contact-info">
            <div class="contact-label">GitHub</div>
            <a href="https://github.com/jungrea" target="_blank" rel="noopener">github.com/jungrea</a>
          </div>
        </div>
        <div class="contact-item">
          <div class="contact-icon">📚</div>
          <div class="contact-info">
            <div class="contact-label">CSDN历史文章</div>
            <a href="https://blog.csdn.net/on2way" target="_blank" rel="noopener">blog.csdn.net/on2way</a>
          </div>
        </div>
        <div class="contact-item">
          <div class="contact-icon">💬</div>
          <div class="contact-info">
            <div class="contact-label">微信公众号</div>
            <span>扫描二维码关注</span>
          </div>
        </div>
      </div>
      <div class="qr-section">
        <img src={withBase('/images/关注.jpg')} alt="微信公众号二维码" class="qr-img" />
        <p class="qr-tip">扫码关注，获取最新文章推送</p>
      </div>
    </div>

    <div class="about-card">
      <h2>关于这个博客</h2>
      <ul>
        <li>🚀 基于 <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 构建</li>
        <li>📝 使用 Markdown 编写文章，本地写作，Git Push 自动部署</li>
        <li>☁️ 部署在 <a href="https://pages.github.com" target="_blank" rel="noopener">GitHub Pages</a></li>
        <li>💻 源码托管在 <a href="https://github.com/jungrea/jungrea.github.io" target="_blank" rel="noopener">GitHub</a></li>
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .section { padding: 3rem 1.5rem 2rem; }

  .page-title {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 2rem;
    text-align: center;
  }

  .about-card {
    max-width: var(--max-width);
    margin: 0 auto 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }

  .about-card h2 {
    font-size: 1.15rem;
    margin: 0 0 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-light);
  }

  .about-card p {
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
  }
  .about-card p:last-child { margin-bottom: 0; }

  .about-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .about-card li {
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }
  .about-card li:last-child { margin-bottom: 0; }

  /* 联系方式布局 */
  .contact-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    background: var(--bg-surface);
    border-radius: var(--radius);
    border: 1px solid var(--border-light);
  }

  .contact-icon {
    font-size: 1.3rem;
    flex-shrink: 0;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .contact-label {
    font-size: 0.78rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .contact-info a {
    font-size: 0.92rem;
    color: var(--accent);
    word-break: break-all;
  }
  .contact-info span {
    font-size: 0.92rem;
    color: var(--text-secondary);
  }

  /* 二维码区域 */
  .qr-section {
    text-align: center;
    padding-top: 1rem;
    border-top: 1px solid var(--border-light);
  }

  .qr-img {
    max-width: 180px;
    border-radius: var(--radius);
    border: 1px solid var(--border-light);
    transition: transform 0.3s ease;
  }
  .qr-img:hover {
    transform: scale(1.05);
  }

  .qr-tip {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-tertiary);
  }
</style>
