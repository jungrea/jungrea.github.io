---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="关于 — My Blog" description="关于我和这个博客" currentPath="/about">
  <div class="container section">
    <h1 class="page-title">👤 关于</h1>

    <div class="about-card">
      <h2>关于我</h2>
      <p>
        你好，我是 <strong>Jungrea</strong>，一名热爱技术的开发者。
      </p>
      <p>
        这个博客记录我在编程、技术、工具等方面的学习与思考。
        我喜欢探索新技术，也乐于分享自己的实践经验。
      </p>
    </div>

    <div class="about-card">
      <h2>关于这个博客</h2>
      <ul>
        <li>🚀 基于 <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 构建</li>
        <li>📝 使用 Markdown 编写文章，本地写作，Git Push 自动部署</li>
        <li>☁️ 部署在 <a href="https://vercel.com" target="_blank" rel="noopener">Vercel</a></li>
        <li>💻 源码托管在 <a href="https://github.com/jungrea/my-blog" target="_blank" rel="noopener">GitHub</a></li>
      </ul>
    </div>

    <div class="about-card">
      <h2>联系我</h2>
      <ul>
        <li>GitHub: <a href="https://github.com/jungrea" target="_blank" rel="noopener">@jungrea</a></li>
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .section { padding: 3rem 1.5rem 2rem; }

  .page-title {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 2rem;
    text-align: center;
  }

  .about-card {
    max-width: var(--max-width);
    margin: 0 auto 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }

  .about-card h2 {
    font-size: 1.15rem;
    margin: 0 0 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-light);
  }

  .about-card p {
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
  }
  .about-card p:last-child { margin-bottom: 0; }

  .about-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .about-card li {
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }
  .about-card li:last-child { margin-bottom: 0; }
</style>
