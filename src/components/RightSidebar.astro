---
import { withBase } from '../utils/url';
import TableOfContents from './TableOfContents.astro';

const { posts = [], headings = [] } = Astro.props;

const sortedPosts = [...posts].sort((a, b) => {
  const bDate = new Date(b.data.updatedDate || b.data.pubDate).valueOf();
  const aDate = new Date(a.data.updatedDate || a.data.pubDate).valueOf();
  return bDate - aDate;
});

const recentPosts = sortedPosts.slice(0, 12);
---

<div class:list={['right-sidebar', { 'has-contents': headings.length > 0 }]}>
  {headings.length > 0 && (
    <section class="side-widget contents-widget">
      <h2 class="side-title">Contents</h2>
      <TableOfContents headings={headings} />
    </section>
  )}

  {recentPosts.length > 0 && (
    <section class="side-widget recent-widget">
      <h2 class="side-title">最近更新</h2>
      <nav class="recent-list" aria-label="最近更新文章">
        {recentPosts.map((post) => (
          <a href={withBase(`/blog/${post.slug}`)}>{post.data.title}</a>
        ))}
      </nav>
    </section>
  )}
</div>

<style>
  .right-sidebar {
    display: flex;
    flex-direction: column;
    gap: 2.2rem;
    color: var(--text-secondary);
  }

  .right-sidebar.has-contents {
    height: calc(100vh - 3rem);
    gap: 0;
  }

  .right-sidebar.has-contents .contents-widget {
    flex: 3 1 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .right-sidebar.has-contents .recent-widget {
    flex: 1 1 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding-top: 1.2rem;
  }

  .side-widget {
    border-left: 1px solid var(--border-light);
    padding-left: 1rem;
  }

  .contents-widget {
    border-left: 0;
    padding-left: 0;
  }

  .side-title {
    margin: 0 0 0.85rem;
    padding: 0;
    border: 0;
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: 0.01em;
  }

  .recent-list {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    max-height: 12rem;
    overflow-y: auto;
    padding-right: 0.35rem;
  }

  .right-sidebar.has-contents .recent-list {
    flex: 1 1 auto;
    min-height: 0;
    max-height: none;
  }

  .recent-list a {
    color: var(--text-secondary);
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .recent-list a:hover {
    color: var(--accent);
  }

  .recent-list::-webkit-scrollbar {
    width: 4px;
  }

  .recent-list::-webkit-scrollbar-track {
    background: transparent;
  }

  .recent-list::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 999px;
  }

  .contents-widget :global(.toc) {
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .contents-widget > .side-title {
    font-size: 1.05rem;
    margin-bottom: 0.95rem;
  }

  .contents-widget :global(.toc-title) {
    display: none;
  }

  .contents-widget :global(.toc-item a) {
    font-size: 0.84rem;
    padding: 0.18rem 0;
  }

  @media (max-width: 1180px) {
    .right-sidebar {
      display: none;
    }
  }
</style>
