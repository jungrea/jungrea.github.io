---
interface TagCount {
  tag: string;
  count: number;
}

const { tags }: { tags: TagCount[] } = Astro.props;
const maxCount = Math.max(...tags.map(t => t.count), 1);
---

<div class="tag-cloud">
  {tags.map(({ tag, count }) => {
    // 根据数量缩放大小
    const ratio = count / maxCount;
    const size = 0.8 + ratio * 0.5; // 0.8 到 1.3
    const href = `/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`;
    return (
      <a href={href} class="tag-item" style={`font-size: ${size}rem`}>
        {tag}
        <span class="tag-count">{count}</span>
      </a>
    );
  })}
</div>

<style>
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    align-items: center;
    padding: 1.5rem 0;
  }

  .tag-item {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    color: var(--text-secondary);
    border: 1px solid var(--border-light);
    background: var(--bg-surface);
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s;
  }
  .tag-item:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-glow);
    transform: translateY(-1px);
  }

  .tag-count {
    font-size: 0.7rem;
    color: var(--text-tertiary);
    font-weight: 400;
  }
</style>
