---
import BaseLayout from './BaseLayout.astro';
import RightSidebar from '../components/RightSidebar.astro';
import TagBadge from '../components/TagBadge.astro';
import { withBase } from '../utils/url';

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  tags?: string[];
  headings?: Array<{ depth: number; text: string; slug: string }>;
  slug: string;
  posts?: any[];
  previousPost?: any;
  nextPost?: any;
}

const {
  title,
  description = '',
  pubDate,
  tags = [],
  headings = [],
  slug,
  posts = [],
  previousPost,
  nextPost,
} = Astro.props;

const dateStr = new Date(pubDate).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} - My Blog`} description={description} currentPath={withBase(`/blog/${slug}`)}>
  <RightSidebar slot="right-sidebar" posts={posts} headings={headings} />

  <article class="post-wrapper">
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      {description && <p class="post-desc">{description}</p>}
      <div class="post-meta">
        <time datetime={pubDate instanceof Date ? pubDate.toISOString() : String(pubDate)}>
          Posted {dateStr}
        </time>
      </div>
      {tags && tags.length > 0 && (
        <div class="post-tags">
          {tags.map((tag: string) => <TagBadge tag={tag} />)}
        </div>
      )}
    </header>

    <div class="post-content">
      <slot />
    </div>

    {(previousPost || nextPost) && (
      <nav class="post-nav" aria-label="文章导航">
        {previousPost ? (
          <a class="post-nav-card prev" href={withBase(`/blog/${previousPost.slug}`)}>
            <span class="post-nav-label">← 上一篇</span>
            <span class="post-nav-title">{previousPost.data.title}</span>
          </a>
        ) : <span class="post-nav-card is-placeholder" aria-hidden="true"></span>}

        {nextPost ? (
          <a class="post-nav-card next" href={withBase(`/blog/${nextPost.slug}`)}>
            <span class="post-nav-label">下一篇 →</span>
            <span class="post-nav-title">{nextPost.data.title}</span>
          </a>
        ) : <span class="post-nav-card is-placeholder" aria-hidden="true"></span>}
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  .post-wrapper {
    max-width: var(--max-width);
    padding: 0.8rem 0 4rem;
  }

  .post-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-light);
  }

  .post-title {
    font-size: clamp(2rem, 3vw, 2.65rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.65rem;
    line-height: 1.22;
  }

  .post-desc {
    color: var(--text-secondary);
    font-size: 1.02rem;
    margin-bottom: 1rem;
  }

  .post-meta {
    display: flex;
    gap: 1.5rem;
    color: var(--text-tertiary);
    font-size: 0.84rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .post-content {
    min-width: 0;
    font-size: 1.02rem;
    line-height: 1.85;
  }

  .post-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 3.2rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--border-light);
  }

  .post-nav-card {
    min-height: 6rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    color: var(--text-primary);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .post-nav-card:hover {
    border-color: var(--accent);
    color: var(--text-primary);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .post-nav-card.next {
    text-align: right;
  }

  .post-nav-card.is-placeholder {
    visibility: hidden;
  }

  .post-nav-label {
    display: block;
    margin-bottom: 0.45rem;
    color: var(--text-tertiary);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .post-nav-title {
    display: block;
    color: var(--text-primary);
    font-size: 0.98rem;
    font-weight: 800;
    line-height: 1.45;
  }

  .post-nav-card:hover .post-nav-title {
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .post-wrapper {
      max-width: none;
    }

    .post-title {
      font-size: 1.7rem;
    }

    .post-nav {
      grid-template-columns: 1fr;
    }

    .post-nav-card.next {
      text-align: left;
    }

    .post-nav-card.is-placeholder {
      display: none;
    }
  }
</style>
