---
import BaseLayout from './BaseLayout.astro';
import RightSidebar from '../components/RightSidebar.astro';
import TagBadge from '../components/TagBadge.astro';
import { withBase } from '../utils/url';

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  tags?: string[];
  headings?: Array<{ depth: number; text: string; slug: string }>;
  slug: string;
  posts?: any[];
}

const {
  title,
  description = '',
  pubDate,
  tags = [],
  headings = [],
  slug,
  posts = [],
} = Astro.props;

const dateStr = new Date(pubDate).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} - My Blog`} description={description} currentPath={withBase(`/blog/${slug}`)}>
  <RightSidebar slot="right-sidebar" posts={posts} headings={headings} />

  <article class="post-wrapper">
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      {description && <p class="post-desc">{description}</p>}
      <div class="post-meta">
        <time datetime={pubDate instanceof Date ? pubDate.toISOString() : String(pubDate)}>
          Posted {dateStr}
        </time>
      </div>
      {tags && tags.length > 0 && (
        <div class="post-tags">
          {tags.map((tag: string) => <TagBadge tag={tag} />)}
        </div>
      )}
    </header>

    <div class="post-content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .post-wrapper {
    max-width: var(--max-width);
    padding: 0.8rem 0 4rem;
  }

  .post-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-light);
  }

  .post-title {
    font-size: clamp(2rem, 3vw, 2.65rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.65rem;
    line-height: 1.22;
  }

  .post-desc {
    color: var(--text-secondary);
    font-size: 1.02rem;
    margin-bottom: 1rem;
  }

  .post-meta {
    display: flex;
    gap: 1.5rem;
    color: var(--text-tertiary);
    font-size: 0.84rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .post-content {
    min-width: 0;
    font-size: 1.02rem;
    line-height: 1.85;
  }

  @media (max-width: 900px) {
    .post-wrapper {
      max-width: none;
    }

    .post-title {
      font-size: 1.7rem;
    }
  }
</style>
