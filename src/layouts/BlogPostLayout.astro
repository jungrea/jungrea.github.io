---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import TagBadge from '../components/TagBadge.astro';

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  tags?: string[];
  headings?: Array<{ depth: number; text: string; slug: string }>;
  slug: string;
}

const {
  title,
  description = '',
  pubDate,
  tags = [],
  headings = [],
  slug,
} = Astro.props;

const dateStr = new Date(pubDate).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} - My Blog`} description={description} currentPath={`/blog/${slug}`}>
  <article class="post-wrapper">
    <!-- 文章头部 -->
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      {description && <p class="post-desc">{description}</p>}
      <div class="post-meta">
        <time datetime={pubDate instanceof Date ? pubDate.toISOString() : String(pubDate)}>
          📅 {dateStr}
        </time>
      </div>
      {tags && tags.length > 0 && (
        <div class="post-tags">
          {tags.map((tag: string) => <TagBadge tag={tag} />)}
        </div>
      )}
    </header>

    <!-- 两栏布局：正文 + 侧边栏 -->
    <div class="post-body">
      <div class="post-content">
        <slot />
      </div>
      {headings.length > 0 && (
        <aside class="post-sidebar">
          <TableOfContents headings={headings} />
        </aside>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .post-wrapper {
    max-width: var(--max-width-wide);
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .post-header {
    max-width: var(--max-width);
    margin: 0 auto 2rem;
    text-align: center;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-light);
  }

  .post-title {
    font-size: 2.2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .post-desc {
    color: var(--text-secondary);
    font-size: 1.05rem;
    margin-bottom: 1rem;
  }

  .post-meta {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    color: var(--text-tertiary);
    font-size: 0.88rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  /* 两栏 */
  .post-body {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
  }

  .post-content {
    flex: 1;
    min-width: 0;
    max-width: var(--max-width);
    margin: 0 auto;
    font-size: 1.02rem;
    line-height: 1.85;
  }

  .post-sidebar {
    width: 220px;
    flex-shrink: 0;
  }

  @media (max-width: 960px) {
    .post-body {
      flex-direction: column;
    }
    .post-sidebar {
      width: 100%;
    }
    .post-title {
      font-size: 1.7rem;
    }
  }
</style>
