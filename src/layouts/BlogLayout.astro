---
export interface Props {
  title: string;
  description?: string;
  pubDate?: Date;
}

const { title, description, pubDate } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | 我的博客</title>
    <meta name="description" content={description || title} />
  </head>
  <body>
    <header>
      <nav>
        <a href="/">首页</a>
        <a href="/blog">文章</a>
        <a href="/about.html">关于</a>
      </nav>
    </header>

    <main>
      <article>
        {pubDate && <time>{pubDate.toLocaleDateString('zh-CN')}</time>}
        <h1>{title}</h1>
        <slot />
      </article>
    </main>

    <footer>
      <p>&copy; 2026 我的博客 - 由 Astro 构建</p>
    </footer>
  </body>
</html>

<style>
  :root {
    --bg: #ffffff;
    --text: #1a1a2e;
    --accent: #4361ee;
  }
  body {
    font-family: system-ui, -apple-system, sans-serif;
    max-width: 720px;
    margin: 0 auto;
    padding: 0 1.5rem;
    color: var(--text);
    background: var(--bg);
    line-height: 1.7;
  }
  header {
    padding: 1.5rem 0;
    border-bottom: 1px solid #eee;
    margin-bottom: 2rem;
  }
  nav { display: flex; gap: 1.5rem; }
  nav a { color: var(--accent); text-decoration: none; font-weight: 500; }
  nav a:hover { text-decoration: underline; }
  time { color: #666; font-size: 0.9rem; display: block; margin-bottom: 0.5rem; }
  footer {
    margin-top: 4rem;
    padding: 1.5rem 0;
    border-top: 1px solid #eee;
    text-align: center;
    color: #888;
    font-size: 0.9rem;
  }
</style>
